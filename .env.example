# 本地单用户医疗资料工作台。未配置密钥仍可使用本地整理功能。
# provider: deepseek / openai / openai-responses / anthropic（claude）/ openai-compatible
AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# OpenAI-compatible（AI_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# OpenRouter 可使用 AI_PROVIDER=openrouter 与 OPENROUTER_API_KEY

# Anthropic Claude（AI_PROVIDER=anthropic）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# 通用请求预算
AI_MAX_TOKENS=8192
AI_TIMEOUT_MS=90000
PORT=8787
# MEDICAL_DATABASE=/absolute/path/medical.sqlite
# 消息接入接口（POST /api/ingest/messages）的共享密钥；未配置时该接口关闭。
# 供本机微信 CLI 等桥接工具推送患者消息，不用于浏览器。
# MEDICAL_INGEST_SECRET=change-me-to-a-long-random-string
# macOS 微信桥接（界面自动化：同步当前聊天窗口、发送回复草稿）。
# 默认关闭；开启需在 系统设置 → 隐私与安全性 中为运行终端授予 辅助功能+自动化 权限。
# MEDICAL_WECHAT_BRIDGE=on
# 微信客户端进程名（逗号分隔，按顺序探测）
# MEDICAL_WECHAT_PROCESS=微信,WeChat
# macOS OS 沙箱：可选的可信 Python 可执行文件，探测失败时禁用代码执行。
# MEDICAL_SANDBOX_PYTHON=/opt/homebrew/bin/python3
# MEDICAL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 本地 OpenAI-compatible 推理服务，无需虚构 API 密钥。模型需在本机另行安装。
# AI_PROVIDER=local
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=your-installed-model

# Optional desktop Docker CLI path (auto-detected on macOS/Windows by default).
# AGENT_DOCKER_EXECUTABLE=/opt/homebrew/bin/docker
# MCP credentials: reference the variable name in the workspace MCP configuration.
# MCP_EXAMPLE_TOKEN=

# Responses 协议与图片分析（设置支持视觉的模型；真实可用性取决于账号）
# AI_PROVIDER=openai-responses
# AI_REASONING_EFFORT=medium
# 独立通用服务
# AGENT_PORT=8788
# AGENT_DATABASE=/absolute/path/platform.sqlite
# The web workbench also supports configuring these values in its Settings panel.
# Saved settings are encrypted locally; environment variables remain the simplest
# option for unattended daemon deployments.

# ---- 医疗知识库向量索引（可选；不配置则知识检索退化为全文匹配）----
# 云端免费方案：注册 siliconflow.cn 获取免费 API Key（BAAI/bge-m3 永久免费），
# 仅指南/知识库公开文本与检索词会发送，患者资料永不上传。
# MEDICAL_EMBEDDING_KEY=sk-xxxxxxxx
# MEDICAL_EMBEDDING_PROVIDER=siliconflow
# MEDICAL_EMBEDDING_URL=https://api.siliconflow.cn/v1
# MEDICAL_EMBEDDING_MODEL=BAAI/bge-m3
# 完全离线方案：本机安装 Ollama 后无需任何 Key 即可自动使用
# MEDICAL_EMBEDDING_PROVIDER=ollama
# MEDICAL_EMBEDDING_URL=http://127.0.0.1:11434
# MEDICAL_EMBEDDING_MODEL=bge-m3

# —— 以下均为可选项，默认即可 ——
# 每轮最大工具条目 / 上下文字符预算 / 轮数上限：
# 轮数默认不限制（上下文接近预算时自动压缩，大工具结果自动归档，可随时手动停止）；
# 如需给失控任务设保险，取消注释并指定数值。
# MEDICAL_MAX_ROUNDS=50
# MEDICAL_CONTEXT_BUDGET=80000
# MEDICAL_MAX_TOOL_CALLS=16
