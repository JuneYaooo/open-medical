{
  "name": "open-medical-agent",
  "private": true,
  "version": "0.9.70",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "agent": "node server/agent.mjs",
    "harness": "node server/agent.mjs",
    "workspace": "node scripts/workspace-cli.mjs",
    "start": "node server/agent.mjs",
    "platform": "node server/platform.mjs",
    "lint": "eslint .",
    "format": "prettier --write src server shared tests scripts *.mjs *.md",
    "check": "npm run lint && npm test && npm run build",
    "backup": "node scripts/backup.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "wechat:inspect": "node scripts/inspect-wechat.mjs",
    "verify:browser-server": "node scripts/verification-server.mjs",
    "postinstall": "node scripts/prepare-pdf-assets.mjs && node scripts/prepare-pty.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs && node scripts/prepare-pty.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "desktop": "electron desktop/main.cjs",
    "package:mac": "npm run build && node scripts/package-desktop.mjs",
    "package:win": "npm run build && node scripts/package-desktop.mjs --platform=win32 --arch=x64",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:offline": "node scripts/verify-offline-package.mjs",
    "test:extensions": "node --test tests/extensions.test.mjs",
    "verify:browser-tools": "electron scripts/verify-browser-tools.cjs",
    "package:offline-tools": "node scripts/build-offline-tools.mjs",
    "verify:disconnected-mac": "node scripts/verify-disconnected-mac.mjs",
    "daemon": "node scripts/agent-daemon.mjs",
    "build:runtime": "node scripts/build-full-runtime.mjs",
    "verify:soak": "node scripts/verify-soak.mjs",
    "verify:agent": "node scripts/evaluate-agent.mjs",
    "build:native-control": "node scripts/build-native-control.mjs",
    "remote:coordinator": "node scripts/remote-coordinator.mjs",
    "remote:worker": "node scripts/remote-worker.mjs",
    "desktop:update": "npm run build:native-control && npm run build && node scripts/update-desktop-runtime.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.38.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wecom/crypto": "1.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "apache-arrow": "^18.1.0",
    "cron-parser": "^5.10.0",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "5.11.1",
    "js-yaml": "^4.3.2",
    "jszip": "3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "mermaid": "^12.0.0",
    "ml-matrix": "^6.15.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tar-stream": "^3.2.1",
    "vite": "^8.2.2",
    "wecom": "1.0.0-rc.2",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^9.39.5",
    "electron": "44.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "type": "module",
  "overrides": {
    "lodash-es": "4.18.1",
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
